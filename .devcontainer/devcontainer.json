// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
	"features": {
		"ghcr.io/devcontainers/features/azure-cli:1": {
			"version": "latest",
			"installAzureAD": true,
			"installAzureDevOps": true,
			"installBicep": true,
			"installKubernetesCLI": true,
			"installHelm": true
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2.14.0": {
			"dockerComposeFile": "docker-compose.yml",
			"dockerComposeService": "app",
			"dockerComposeRemoveVolumes": true
		},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"version": "latest",
			"installMinikube": false,
			"installKubectl": true,
			"installHelm": true,
			"installKustomize": true,
			"installSkaffold": true,
			"installK9s": true
		},
		"ghcr.io/devcontainers/features/terraform": {
			"version": "latest",
			"installAzureRMProvider": true,
			"installAzureADProvider": true,
			"installKubernetesProvider": true,
			"installHelmProvider": true
		},
		"ghcr.io/devcontainers/features/github-cli:1": {
			"installGitLFS": true,
			"version": "latest"
		},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts",
			"installYarn": true,
			"installNpm": true,
			"installPnpm": true
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"hashicorp.terraform",
				"ms-dotnettools.vscodeintellicode-csharp",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"GitHub.vscode-pull-request-github",
				"ms-azuretools.vscode-docker",
				"ms-vscode.azurecli",
				"ms-dotnettools.vscode-dotnet-runtime",
				"github.vscode-github-actions"
			]
		}
	},
	// Use 'postCreateCommand' to run commands after the container is created.
	// This installs kubelogin (Azure Kubernetes authentication helper) and verifies the dev environment
	"postCreateCommand": "curl -L https://github.com/Azure/kubelogin/releases/latest/download/kubelogin-linux-amd64.zip -o /tmp/kubelogin.zip && sudo unzip -q /tmp/kubelogin.zip -d /tmp && sudo mv /tmp/bin/linux_amd64/kubelogin /usr/local/bin/ && sudo chmod +x /usr/local/bin/kubelogin && sudo rm -rf /tmp/kubelogin.zip /tmp/bin && echo '✅ kubelogin installed successfully!' && .devcontainer/verify-setup.sh"
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}